"Where PJ_NUMMER IN (Select PJ_Nummer From PROJEKT PR Where LTRIM(RTRIM(PR.PJ_BESCHR0)) = '"+OrderNr+"' and LTRIM(RTRIM(PR.PJ_NAME)) = 'Engineering') " + Environment.newline +
